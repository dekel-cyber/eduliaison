rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profiles & roles
    match /users/{userId} {
      allow read, write: if true;
    }

    // Registered emails directory for pre-login verification
    match /registered_emails/{emailId} {
      allow read, write: if true;
    }

    // Students
    match /students/{studentId} {
      allow read, write: if true;
    }

    // Classes
    match /classes/{classId} {
      allow read, write: if true;
    }

    // Activity Logs & Audit
    match /activity_logs/{logId} {
      allow read, write: if true;
    }

    // Circulars & Broadcasts
    match /circulars/{circularId} {
      allow read, write: if true;
    }

    // Timeline Events
    match /timeline_events/{eventId} {
      allow read, write: if true;
    }

    // Attendance Records
    match /attendance_records/{attendanceId} {
      allow read, write: if true;
    }

    // School Documents & Circulars
    match /school_documents/{documentId} {
      allow read, write: if true;
    }

    // Message threads
    match /message_threads/{threadId} {
      allow read, write: if true;
    }

    // Connection check & test
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
