# ==============================================================================
# Variables d'Environnement - EduLiaison (Déploiement Render / Production)
# ==============================================================================

# 1. Mode d'exécution
NODE_ENV=production

# 2. Port d'écoute (Render fournit automatiquement la variable PORT, ex: 10000)
PORT=10000

# 3. URL publique de l'application (votre sous-domaine Render ou nom de domaine personnalisé)
# Exemple: https://eduliaison.onrender.com ou https://eduliaison.ci
APP_URL=https://eduliaison.onrender.com

# 4. Configuration Serveur Mail SMTP (Envoi de codes de réinitialisation et emails de bienvenue)
# Compatible avec Gmail (Mot de passe d'application), Brevo/Sendinblue, Resend, Mailgun, OVH, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre_email_smtp@gmail.com
SMTP_PASS=votre_mot_de_passe_d_application_16_caracteres
SMTP_FROM=EduLiaison <notifications@eduliaison.ci>

# 5. Clés Firebase (Déjà incluses dans firebase-applet-config.json, optionnelles en variables d'environnement)
# VITE_FIREBASE_API_KEY=AIzaSyC9XLOk5wzWeMMixVmo_QmZInV1spN_WPQ
# VITE_FIREBASE_AUTH_DOMAIN=gen-lang-client-0390223607.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=gen-lang-client-0390223607
